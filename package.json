  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "zshy && node -e \"const fs=require('fs'),p=JSON.parse(fs.readFileSync('package.json'));for(const k of Object.keys(p.exports))if(k.endsWith('/*')){const d='./dist/'+k.slice(2,-1);p.exports[k]={types:d+'*.d.cts',import:d+'*.js',require:d+'*.cjs'}}fs.writeFileSync('package.json',JSON.stringify(p,null,2)+'\\n')\" && node scripts/generate-narrow-imports.mjs && node scripts/check-portable-dts.mjs && node scripts/generate-portable-capability-contracts.mjs",
    "check:dts": "node scripts/generate-narrow-imports.mjs && node scripts/check-portable-dts.mjs",
    "check:pack": "publint && attw --pack . --profile node16 --ignore-rules false-cjs",
    "validate": "pnpm build && pnpm check:pack && pnpm test",
    "test": "vitest run --maxWorkers=2 --testTimeout=60000 && node tests/cjs/smoke.cjs",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "prepare": "husky",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^9.39.4",
    "husky": "^9",
    "publint": "^0.3.18",
    "typescript": "^6.0.2",
    "vitest": "^3.0.0",
    "zod": "^4.3.6",
    "zshy": "^0.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}
