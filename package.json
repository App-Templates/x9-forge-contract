      "./messaging/*": "./src/messaging/**/*",
      "./model-router/*": "./src/model-router/**/*",
      "./organization/*": "./src/organization/**/*",
      "./rag/*": "./src/rag/**/*",
      "./vault/*": "./src/vault/**/*"
    }
  },
